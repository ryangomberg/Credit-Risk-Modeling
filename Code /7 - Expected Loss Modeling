def outstanding_balance(R, i, t, n):
  """ Returns the outstanding balance of a loan
      after t payments
      Arguments: monthly payment, monthly interest rate,
      current payment term, loan term
      Output: the outstanding balance expressed as a real
      number
  """
  v_i = 1/((1 + i)**(n - t))
  OB = (R * (1 - v_i))/i
  time = t
  return time, OB
  
