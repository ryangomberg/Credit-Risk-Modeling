def expected_loss(R, i, n, pd):
  """ Returns the expected loss of a loan
      Arguments: monthly payments, monthly rate,
      loan term, probability of default
      Output: expected loss expressed as a real
      number
  """
  t, Sp = survival_prob(pd, n)
  exp_loss = []
  S = np.insert(Sp, 0, 1)
  for k in np.arange(1, n + 1):
    PD_t = S[k - 1] - S[k]
    time, OB_t = outstanding_balance(R, i, k, n)
    exp_loss.append(PD_t * OB_t * (1 + i)**(-k) * 0.6)
  return sum(exp_loss)
  
