# Identify features with at most 9 classes
for col in num_unique.index:
uniq_count = num_unique[col]
if uniq_count < 10:
uniq_vals = df[col].dropna().unique()
print(f"{col}: {uniq_count} ({list(uniq_vals)})")
else:
print(f"{col}: {uniq_count}")

