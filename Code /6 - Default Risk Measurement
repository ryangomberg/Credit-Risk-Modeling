# Hazard rate, survival probability, expected loan value computations
def hazard_rate(pd, term):
  """ Returns the constant hazard rate of a borrower's ability to
      repay a loan
      Arguments: probability of default and term of the loan
      Output: the constant hazard rate expressed as a real number
  """
  return -np.log(1 - pd)/term
  
def survival_prob(pd, term):
  """ Returns the survival probabilities at each payment in
      a loan amortization term for a given borrower
      Arguments: probability of default and term of the loan
      Output: a 1 x term array containing survival probabilities,
      each expressed as real numbers
  """
  lamb = hazard_rate(pd, term)
  t = np.arange(1, term + 1)
  Sp = np.exp(-lamb * t)
  return t, Sp

