def expected_LV(pd, term, R, i):
  """ Returns the expected loan value for a given borrower
      Arguments: probability of default, term of the loan,
      monthly payments, and monthly interest rate
      Output: the expected loan value, expressed as a
      real number
  """
  t, Sp = survival_prob(pd, term)
  v_t = 1/(1 + i)**t
  return np.sum(Sp * R * v_t)
  
