# Bootstrapping over 1000 samples
from sklearn.metrics import roc_auc_score
def bootstrap_auc(y_true, y_pred_proba, n_boot = 1000, random_state = 42):
  """ Returns the original AUC, mean AUC, and the lower and upper
  limits of the 95% confidence interval for the AUC
  Arguments: actual value of test data, predicted value of test
  data
  Output: original and mean AUC, as well as the bounds of the
  95% confidence interval
  """
  rng = np.random.default_rng(random_state)
  n = len(y_true)
  aucs = []
  for _ in range(n_boot):
    idx = rng.integers(0, n, n)
    if len(np.unique(y_true.iloc[idx])) < 2:
      continue
    auc = roc_auc_score(y_true.iloc[idx], y_pred_proba[idx])
    aucs.append(auc)
  aucs = np.array(aucs)
  lowerperc = np.percentile(aucs, 2.5)
  upperperc = np.percentile(aucs, 97.5)
  return {
    "original_auc": roc_auc_score(y_true, y_pred_proba),
    "mean_auc": aucs.mean(),
    "ci_lower": lowerperc,
    "ci_upper": upperperc,
  }
  
results = bootstrap_auc(y2_test, y_problog2)
print("Mean Bootstrap AUC:", results["mean_auc"])
print("95% CI:", results["ci_lower"], "-", results["ci_upper"])

results_L1 = bootstrap_auc(ys_test, y_problog3)
print("Mean Bootstrap L1 AUC:", results_L1["mean_auc"])
print("95% CI L1:", results_L1["ci_lower"], "-", results_L1["ci_upper"])

