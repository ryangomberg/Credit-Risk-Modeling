# Full amortization schedule
def amortization_schedule(loan_amount, monthly_rate, term_length, payment):
  """ Returns an amortization schedule of a loan
  Arguments: loan amount, monthly interest rate, term length, monthly payment
  Output: A pandas DataFrame with a term_length x 5 shape
  The columns include the payment, interest, principal, and remaining balance
  for each month
  """
  balance = loan_amount

  schedule = []
  
  for month in range(1, term_length + 1): # Iterates over each month in loan term
    interest = balance * monthly_rate
    principal = payment - interest
    balance -= principal
    
    # Add columns to the schedule DataFrame
    schedule.append({
      "Month": month,
      "Payment": payment,
      "Interest": interest,
      "Principal": principal,
      "Remaining Balance": max(balance, 0)
    })
    
  return pd.DataFrame(schedule)
  
