def MacD(i, n):
  """ returns the Macaulay Duration of an asset with
      level payments
      Arguments: monthly interest rate, loan term
      Output: Macaulay duration of the annuity, expressed
      as a positive number
  """
  v_i = (1 + i)**(-n)
  ann_imm = (1 - v_i)/i
  ann_due = ann_imm * (1 + i)
  ann_inc = (ann_due - n*v_i)/i
  macD = ann_inc/(12*ann_imm)
  return macD

def ModD(i, n):
  """ returns the Modified Duration of an asset
      Arguments: monthly interest rate, loan term
      Output: Modified duration of the annuity, expressed
      as a positive number
  """
  macD = MacD(i, n)
  modD = macD/(1 + i)
  return modD

def new_LV(L_i0, i, n, delta_i):
  """ returns the new loan value under changes in
  the interest rate
  Arguments: initial loan amount, monthly interest rate,
  loan term, change in interest rate (positive or negative)
  Output: the new loan value, expressed as a positive number
  """
  modD = ModD(i, n)
  L_i1 = L_i0 - (delta_i * L_i0 * modD)
  return L_i1

def LV_spectrum(L_i0, i, n, delta_i):
  """ outputs the spectrum of new values under changes in
  the interest rate
  Arguments: initial loan amount, monthly interest rate,
  loan term, change in interest rate (positive or negative)
  Output: a 21 x 2 numpy array containing the interest rate
  and its respective loan value
  """
  
  rate_arr = np.arange(i - delta_i, i + delta_i + delta_i/10, delta_i/10)
  loan_vals = []
  for k in rate_arr:
    macD = MacD(k, n)
    new_LV = L_i0 * ((1 + i)/(1 + k)) ** macD
    loan_vals.append(new_LV)
    
  return np.column_stack((rate_arr, loan_vals))

